services:
  app:
    image: {{ shared_calendar_image }}:${IMAGE_TAG:?IMAGE_TAG not set}
    container_name: shared-calendar
    restart: unless-stopped
    env_file: .env
    mem_limit: 256m
    environment:
      NODE_OPTIONS: --max-old-space-size=160
    networks:
      - {{ traefik_network }}
    healthcheck:
      test: ["CMD", "node", "-e", "fetch('http://127.0.0.1:3000/healthz').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"]
      interval: 30s
      start_period: 20s
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.calendar.rule=Host(`{{ shared_calendar_domain }}`)"
      - "traefik.http.routers.calendar.entrypoints=calendar"
      - "traefik.http.routers.calendar.tls.certresolver=letsencrypt"
      - "traefik.http.services.calendar.loadbalancer.server.port=3000"

networks:
  {{ traefik_network }}:
    external: true
