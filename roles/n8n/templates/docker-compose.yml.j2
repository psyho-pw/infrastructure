services:
  n8n:
    image: n8nio/n8n:{{ n8n_version | default('latest') }}
    container_name: n8n
    restart: unless-stopped
    environment:
      - GENERIC_TIMEZONE={{ timezone | default('Asia/Seoul') }}
      - TZ={{ timezone | default('Asia/Seoul') }}
      - N8N_HOST={{ n8n_domain }}
      - N8N_PORT=5678
      - N8N_PROTOCOL=https
      - N8N_PATH={{ n8n_path | default('/') }}
      - WEBHOOK_URL=https://{{ n8n_domain }}{{ n8n_path | default('') }}
      - N8N_EDITOR_BASE_URL=https://{{ n8n_domain }}{{ n8n_path | default('') }}
{% if n8n_basic_auth_active | default(false) %}
      - N8N_BASIC_AUTH_ACTIVE=true
      - N8N_BASIC_AUTH_USER={{ n8n_basic_auth_user }}
      - N8N_BASIC_AUTH_PASSWORD={{ n8n_basic_auth_password }}
{% endif %}
    volumes:
      - {{ n8n_data_dir }}:/home/node/.n8n
    networks:
      - {{ traefik_network }}
    labels:
      - "traefik.enable=true"
      # StripPrefix 미들웨어
      - "traefik.http.middlewares.n8n-stripprefix.stripprefix.prefixes={{ n8n_path | default('/') }}"
      # HTTP → HTTPS 리다이렉트
      - "traefik.http.routers.n8n-http.rule=Host(`{{ n8n_domain }}`) && PathPrefix(`{{ n8n_path | default('/') }}`)"
      - "traefik.http.routers.n8n-http.entrypoints=web"
      - "traefik.http.routers.n8n-http.middlewares=redirect-to-https"
      # HTTPS 라우터
      - "traefik.http.routers.n8n.rule=Host(`{{ n8n_domain }}`) && PathPrefix(`{{ n8n_path | default('/') }}`)"
      - "traefik.http.routers.n8n.entrypoints=websecure"
      - "traefik.http.routers.n8n.tls.certresolver=letsencrypt"
      - "traefik.http.routers.n8n.middlewares=n8n-stripprefix"
      - "traefik.http.routers.n8n.service=n8n"
      - "traefik.http.services.n8n.loadbalancer.server.port=5678"

networks:
  {{ traefik_network }}:
    external: true
